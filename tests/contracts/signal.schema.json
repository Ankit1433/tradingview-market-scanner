{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "type":"object",
 "required":["id","eventKey","ts","mode","symbol","signals","signalCount","price","confluence","levels","context"],
 "properties":{
  "id":{"type":"string","pattern":"^[a-f0-9-]{36}$"},
  "eventKey":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "ts":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}T"},
  "mode":{"enum":["intraday","swing"]},"symbol":{"type":"string","minLength":1},
  "signals":{"type":"array","items":{"type":"string"}},"signalCount":{"type":"integer","minimum":0},
  "price":{"type":["number","null"]},"confluence":{"type":"boolean"},
  "levels":{"type":["object","null"],"properties":{"entry":{"type":["number","null"]},"stop":{"type":["number","null"]},"target":{"type":["number","null"]}},"additionalProperties":true},
  "context":{"type":["object","null"]}
 },"additionalProperties":true
}
