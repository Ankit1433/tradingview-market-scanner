{
  "name": "ankquant",
  "version": "1.0.0",
  "description": "NSE/BSE scanner with two independent modes: live intraday momentum (5-min signals, Telegram alerts, confluence-gated sizing) and daily swing (ATR-based stops, R-multiple targets, persistent multi-day position tracking).",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "backtest": "node src/backtest/backtest.js",
    "backfill:swing": "node scripts/backfill-swing.js",
    "test:swing": "node test-swing.js",
    "test:swing-backfill": "node test-swing-backfill.js",
    "test:api": "node test-api.js",
    "test:signal-consistency": "node test-signal-consistency.js",
    "test": "node test-swing.js && node test-swing-backfill.js && node test-api.js && node test-ingest.js && node test-signal-consistency.js && node test-phase0.js && node test-evidence.js && node test-ui.js && node test-personal.js && node test-phase5.js && node test-keepalive.js && node test-upstox.js && node test-alerts.js && node test-reliability.js && node test-bootstrap.js && node tests/contracts/api.js",
    "test:ingest": "node test-ingest.js",
    "test:phase0": "node test-phase0.js",
    "test:evidence": "node test-evidence.js",
    "outcomes": "node scripts/evaluate-outcomes.js",
    "backtest:swing": "node scripts/backtest-swing.js",
    "test:ui": "node test-ui.js",
    "test:personal": "node test-personal.js",
    "accounts:bootstrap": "node scripts/bootstrap-admin.js",
    "test:phase5": "node test-phase5.js",
    "test:browser": "node test-browser.js",
    "test:keepalive": "node test-keepalive.js",
    "test:upstox": "node test-upstox.js",
    "check:upstox": "node scripts/check-upstox.js",
    "launch:check": "node scripts/check-launch.js",
    "compare:screeners": "node scripts/compare-screener.js",
    "test:alerts": "node test-alerts.js",
    "test:reliability": "node test-reliability.js",
    "journal:backup": "node scripts/journal-backup.js",
    "test:contracts": "node tests/contracts/api.js",
    "test:load": "node tests/sse-load.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mathieuc/tradingview": "^3.5.2",
    "@supabase/server": "^1.9.2",
    "axios": "^1.7.0",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "protobufjs": "^8.8.1",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "ajv": "^8.20.0"
  }
}
