# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file - it's already in .gitignore.

# Telegram bot (create via @BotFather, then message your bot/group once
# and hit https://api.telegram.org/bot<token>/getUpdates to find CHAT_ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: TradingView account cookies, only needed if you want data feeds
# that require login (most NSE 5-min candle history works without this).
# Get these from your browser devtools -> Application -> Cookies on
# tradingview.com: `sessionid` and `sessionid_sign`.
TV_SESSION=
TV_SIGNATURE=

# Server
PORT=4000

# Set to "true" to run the loop in TEST_MODE (ignores market hours/weekends,
# same as TEST_MODE in the original Python script)
TEST_MODE=false

# ---- Loop toggles ----
# Both default to enabled. Set to "false" to run only one mode - e.g. swing
# only, if you're not actively day trading (much lighter: one scan a day
# instead of a 15-second tick loop).
ENABLE_INTRADAY=true
ENABLE_SWING=true

# Where swing state (open positions, closed trade journal) is persisted.
# Defaults to ./data. Unlike intraday state, this MUST survive restarts.
SWING_DATA_DIR=./data

# ---- API security ----
# REQUIRED before deploying publicly. Admin endpoints (start/stop/scan/close)
# fail CLOSED without this - an unset key disables them rather than opening
# them to everyone. Generate one with: openssl rand -hex 32
API_KEY=

# When true, public reads report R-multiples and percentages instead of rupee
# P&L, so a portfolio site can show real performance without publishing your
# account size. Supply the API key to see full figures.
PUBLIC_MODE=false

# Requests per minute per IP on /api/*
RATE_LIMIT_PER_MIN=60

# Restrict to your portfolio's origin in production, e.g. https://yoursite.com
CORS_ORIGIN=*

# ---- Split deployment (see DEPLOY.md) ----
# Run this instance as a read-only API that receives signals over HTTP instead
# of scanning itself. Use on a cloud host, where TradingView's undocumented
# endpoints are commonly blocked from datacenter IPs.
INGEST_MODE=false

# On the SCANNER side: forward signals to a hosted instance.
# PUSH_API_KEY must match that instance's API_KEY.
PUSH_URL=
PUSH_API_KEY=
PUSH_FLUSH_MS=5000
