# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file - it's already in .gitignore.

# Telegram bot (create via @BotFather. For a channel, add the bot as an admin
# with permission to post messages; use its @username or numeric chat ID here.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: TradingView account cookies, only needed if you want data feeds
# that require login (most NSE 5-min candle history works without this).
# Get these from your browser devtools -> Application -> Cookies on
# tradingview.com: `sessionid` and `sessionid_sign`.
TV_SESSION=
TV_SIGNATURE=

# Server
PORT=4000

# ---- Supabase persistence (optional locally, recommended on Render) ----
# Run supabase/migrations/202610180001_persistent_scanner_data.sql in the
# Supabase SQL Editor, then add these values to the backend service only.
# Use the project's URL and a secret API key (or legacy service_role key).
# Never put the secret key in public/ browser code or commit it to Git.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alternative if your project still uses the older API keys:
# SUPABASE_SERVICE_ROLE_KEY=

# Set to "true" to run the loop in TEST_MODE (ignores market hours/weekends,
# same as TEST_MODE in the original Python script)
TEST_MODE=false

# ---- Loop toggles ----
# Both default to enabled. Set to "false" to run only one mode - e.g. swing
# only, if you're not actively day trading (much lighter: one scan a day
# instead of a 15-second tick loop).
ENABLE_INTRADAY=true
ENABLE_SWING=true

# Where swing state (open positions, closed trade journal) is persisted.
# Defaults to ./data. Unlike intraday state, this MUST survive restarts.
SWING_DATA_DIR=./data

# ---- API security ----
# REQUIRED before deploying publicly. Admin endpoints (start/stop/scan/close)
# fail CLOSED without this - an unset key disables them rather than opening
# them to everyone. Generate one with: openssl rand -hex 32
API_KEY=

# When true, public reads report R-multiples and percentages instead of rupee
# P&L, so a portfolio site can show real performance without publishing your
# account size. Supply the API key to see full figures.
PUBLIC_MODE=false

# Requests per minute per IP on /api/*
RATE_LIMIT_PER_MIN=60

# Restrict to your portfolio's origin in production, e.g. https://yoursite.com
CORS_ORIGIN=*

# ---- Split deployment (see DEPLOY.md) ----
# Run this instance as a read-only API that receives signals over HTTP instead
# of scanning itself. Use on a cloud host, where TradingView's undocumented
# endpoints are commonly blocked from datacenter IPs.
INGEST_MODE=false

# On the SCANNER side: forward signals to a hosted instance.
# PUSH_API_KEY must match that instance's API_KEY.
PUSH_URL=
PUSH_API_KEY=
PUSH_FLUSH_MS=5000

# IST daily candle completion and swing scan times (HH:MM, >= 15:30).
# Scan must be at or after completion. Both default to 15:45.
SWING_BAR_COMPLETE_TIME=15:45
SWING_SCAN_TIME=15:45

# Forward paper evidence every 15 minutes on scanner instances.
ENABLE_OUTCOMES=true

# Private accounts require the account migration and Supabase; no file fallback.
PRIVATE_MODE=true
APP_ORIGIN=http://localhost:4000
# Only ONE process with working TradingView access should enable this worker.
ENABLE_PERSONAL_WORKER=false
TELEGRAM_BOT_USERNAME=
# Temporary backend-only bootstrap values; remove after creating the first admin.
# Render free plan: opt in temporarily, then remove all bootstrap values.
BOOTSTRAP_ADMIN_ON_START=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Scanner-to-host keepalive only, IST, inclusive endpoints; no weekend/holiday heartbeats.
KEEPALIVE_WINDOW=08:55-15:45
KEEPALIVE_INTERVAL_MS=480000

# Phase 8: do not cut over until authenticated staging/parity checks pass.
MARKET_DATA_PROVIDER=tradingview
UPSTOX_ACCESS_TOKEN=
UPSTOX_FINALIZATION_DELAY_MS=10000
# Explicit approval of documented formulas/universe differences, not proof of parity.
UPSTOX_SCREENING_APPROVED=false
UPSTOX_UNIVERSE_FILE=
UPSTOX_STREAM_ENABLED=false
UPSTOX_STREAM_SYMBOLS=NIFTY

# Phase 3 filtering/dispatch; requires personal worker, Supabase migration and private links.
SIGNAL_ALERTS_ENABLED=true
